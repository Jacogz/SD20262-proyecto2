# Copiar a config.env y ajustar. config.env NO se sube a git.
AWS_REGION=us-east-1
# Perfil de ~/.aws/credentials con el que se ejecutan los scripts
AWS_PROFILE=personal-admin

# Nombre global único. Si se deja vacío: saber11-datalake-<account_id>
DATALAKE_BUCKET=

# Instancia RDS ya creada en el punto 2
RDS_INSTANCE_ID=sedes-educativas-rdb

# EC2 de ingesta
EC2_NAME=ingesta-datalake
EC2_INSTANCE_TYPE=t3.micro
# Vacío = 02_launch_ec2.sh crea un rol + instance profile mínimos (<EC2_NAME>-role).
# Solo poner un nombre si ya existe un instance profile que se quiera reutilizar.
EC2_INSTANCE_PROFILE=
EC2_KEY_NAME=ingesta-key

# Cuentas/roles de compañeros en OTRAS cuentas AWS: leen todo el bucket y escriben
# trusted/, refined/ y athena-results/. Separados por espacio y ENTRE COMILLAS. El ARN debe existir.
# Recomendado: la raíz de la cuenta (cada dueño decide luego qué roles suyos acceden):
#   "arn:aws:iam::111122223333:root arn:aws:iam::444455556666:root"
# O un rol puntual: "arn:aws:iam::111122223333:role/glue-proyecto-role"
TEAM_PRINCIPALS=
